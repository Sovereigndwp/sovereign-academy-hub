{
  "alias": [
    "thesovereign.academy"
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/institutional",
      "destination": "/institutional/index.html"
    },
    {
      "source": "/institutional/",
      "destination": "/institutional/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/legal/",
      "destination": "/legal/index.html"
    },
    {
      "source": "/legal/disclaimer",
      "destination": "/legal/disclaimer/index.html"
    },
    {
      "source": "/legal/disclaimer/",
      "destination": "/legal/disclaimer/index.html"
    },
    {
      "source": "/stress-test",
      "destination": "/stress-test/index.html"
    },
    {
      "source": "/stress-test/submit",
      "destination": "/stress-test/submit/index.html"
    },
    {
      "source": "/stress-test/result",
      "destination": "/stress-test/result/index.html"
    },
    {
      "source": "/stress-test/review",
      "destination": "/stress-test/review/index.html"
    }
  ]
}
